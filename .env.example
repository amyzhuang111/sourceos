# SourceOS environment variables.
# Copy to .env.local and fill in what you have. The app boots and every core
# page renders with none of these set — only the LLM-backed features
# (Run research / scoring) require ANTHROPIC_API_KEY.

# --- Database (required) ---
# Postgres connection string (Neon, Vercel Postgres, or any Postgres works).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- LLM provider (required for Run research / scoring) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional override — defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Search provider (optional, not yet wired into any agent) ---
# https://exa.ai — the adapter exists (src/lib/providers/search/exa.ts) but
# nothing calls it yet since Scout/autonomous discovery isn't built.
EXA_API_KEY=
